{
  "entities": {
    "ApkRelease": {
      "title": "ApkRelease",
      "description": "Published KadirHub Android APK release metadata with version info, changelog description, SHA-256 digest, and optional WebP app icon.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "appName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "packageName": { "type": "string", "maxLength": 160 },
        "versionName": { "type": "string", "minLength": 1, "maxLength": 64 },
        "versionCode": { "type": "integer" },
        "description": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "fileName": { "type": "string", "minLength": 1, "maxLength": 180 },
        "mimeType": { "type": "string", "minLength": 1, "maxLength": 120 },
        "byteSize": { "type": "integer" },
        "fileSizeLabel": { "type": "string", "minLength": 1, "maxLength": 40 },
        "chunkCount": { "type": "integer" },
        "sha256Checksum": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$" },
        "encryptionAlgorithm": { "type": "string", "enum": ["AES-256-GCM"] },
        "iconBase64": { "type": "string", "maxLength": 120000 },
        "isMain": { "type": "boolean" },
        "isPublished": { "type": "boolean" },
        "uploaderUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "appName", "packageName", "versionName", "versionCode", "description",
        "fileName", "mimeType", "byteSize", "fileSizeLabel", "chunkCount",
        "sha256Checksum", "encryptionAlgorithm", "iconBase64", "isMain",
        "isPublished", "uploaderUid", "createdAt", "updatedAt"
      ]
    },
    "ApkFilePayload": {
      "title": "ApkFilePayload",
      "description": "AES-256-GCM encrypted APK file header and inline ciphertext (when <= 450,000 bytes) or chunk manifest.",
      "type": "object",
      "properties": {
        "releaseId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fileName": { "type": "string", "minLength": 1, "maxLength": 180 },
        "mimeType": { "type": "string", "minLength": 1, "maxLength": 120 },
        "byteSize": { "type": "integer" },
        "chunkCount": { "type": "integer" },
        "ciphertextBase64": { "type": "string", "maxLength": 750000 },
        "ivBase64": { "type": "string", "maxLength": 64 },
        "sha256Checksum": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$" },
        "isPublished": { "type": "boolean" },
        "uploaderUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "releaseId", "fileName", "mimeType", "byteSize", "chunkCount",
        "ciphertextBase64", "ivBase64", "sha256Checksum", "isPublished",
        "uploaderUid", "createdAt", "updatedAt"
      ]
    },
    "ApkFileChunk": {
      "title": "ApkFileChunk",
      "description": "Encrypted 450,000-byte APK segment stored under /apk_files/{releaseId}/chunks/chunk_{index}.",
      "type": "object",
      "properties": {
        "releaseId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "chunkIndex": { "type": "integer" },
        "byteSize": { "type": "integer" },
        "ciphertextBase64": { "type": "string", "minLength": 1, "maxLength": 750000 },
        "ivBase64": { "type": "string", "minLength": 8, "maxLength": 64 },
        "uploaderUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "releaseId", "chunkIndex", "byteSize", "ciphertextBase64", "ivBase64",
        "uploaderUid", "createdAt", "updatedAt"
      ]
    }
  },
  "firestore": {
    "/apk_releases/{releaseId}": {
      "schema": { "$ref": "#/entities/ApkRelease" },
      "description": "Publicly readable APK release versions and changelogs; writable exclusively by kadir25.bd@gmail.com."
    },
    "/apk_files/{releaseId}": {
      "schema": { "$ref": "#/entities/ApkFilePayload" },
      "description": "AES-256-GCM encrypted APK file manifest or single-doc payload; publicly downloadable without sign-in when published."
    },
    "/apk_files/{releaseId}/chunks/{chunkId}": {
      "schema": { "$ref": "#/entities/ApkFileChunk" },
      "description": "Encrypted 450KB chunks for large APK downloads up to 100 MB."
    }
  }
}
