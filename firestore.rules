rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Hardened Global Primitives ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner() {
      return isVerifiedUser() && request.auth.token.email == 'kadir25.bd@gmail.com';
    }

    // --- Validation Blueprints ---
    function isValidApkRelease(data) {
      return data.keys().hasAll([
          'id', 'appName', 'packageName', 'versionName', 'versionCode',
          'description', 'fileName', 'mimeType', 'byteSize', 'fileSizeLabel',
          'chunkCount', 'sha256Checksum', 'encryptionAlgorithm', 'iconBase64',
          'isMain', 'isPublished', 'uploaderUid', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'appName', 'packageName', 'versionName', 'versionCode',
          'description', 'fileName', 'mimeType', 'byteSize', 'fileSizeLabel',
          'chunkCount', 'sha256Checksum', 'encryptionAlgorithm', 'iconBase64',
          'isMain', 'isPublished', 'uploaderUid', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.appName is string && data.appName.size() >= 1 && data.appName.size() <= 120
        && data.packageName is string && data.packageName.size() <= 160
        && data.versionName is string && data.versionName.size() >= 1 && data.versionName.size() <= 64
        && data.versionCode is int && data.versionCode >= 1 && data.versionCode <= 999999999
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 4000
        && data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 180
        && data.mimeType is string && data.mimeType.size() >= 1 && data.mimeType.size() <= 120
        && data.byteSize is int && data.byteSize >= 1 && data.byteSize <= 104857600
        && data.fileSizeLabel is string && data.fileSizeLabel.size() >= 1 && data.fileSizeLabel.size() <= 40
        && data.chunkCount is int && data.chunkCount >= 0 && data.chunkCount <= 500
        && data.sha256Checksum is string && data.sha256Checksum.size() == 64 && data.sha256Checksum.matches('^[a-f0-9]{64}$')
        && data.encryptionAlgorithm == 'AES-256-GCM'
        && data.iconBase64 is string && data.iconBase64.size() <= 120000
        && data.isMain is bool
        && data.isPublished is bool
        && isValidId(data.uploaderUid)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidApkFilePayload(data) {
      return data.keys().hasAll([
          'releaseId', 'fileName', 'mimeType', 'byteSize', 'chunkCount',
          'ciphertextBase64', 'ivBase64', 'sha256Checksum', 'isPublished',
          'uploaderUid', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'releaseId', 'fileName', 'mimeType', 'byteSize', 'chunkCount',
          'ciphertextBase64', 'ivBase64', 'sha256Checksum', 'isPublished',
          'uploaderUid', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.releaseId)
        && data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 180
        && data.mimeType is string && data.mimeType.size() >= 1 && data.mimeType.size() <= 120
        && data.byteSize is int && data.byteSize >= 1 && data.byteSize <= 104857600
        && data.chunkCount is int && data.chunkCount >= 0 && data.chunkCount <= 500
        && data.ciphertextBase64 is string && data.ciphertextBase64.size() <= 750000
        && data.ivBase64 is string && data.ivBase64.size() <= 64
        && data.sha256Checksum is string && data.sha256Checksum.size() == 64 && data.sha256Checksum.matches('^[a-f0-9]{64}$')
        && data.isPublished is bool
        && isValidId(data.uploaderUid)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidApkFileChunk(data) {
      return data.keys().hasAll([
          'releaseId', 'chunkIndex', 'byteSize', 'ciphertextBase64', 'ivBase64',
          'uploaderUid', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'releaseId', 'chunkIndex', 'byteSize', 'ciphertextBase64', 'ivBase64',
          'uploaderUid', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.releaseId)
        && data.chunkIndex is int && data.chunkIndex >= 0 && data.chunkIndex <= 500
        && data.byteSize is int && data.byteSize >= 1 && data.byteSize <= 450000
        && data.ciphertextBase64 is string && data.ciphertextBase64.size() >= 1 && data.ciphertextBase64.size() <= 750000
        && data.ivBase64 is string && data.ivBase64.size() >= 8 && data.ivBase64.size() <= 64
        && isValidId(data.uploaderUid)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // --- Collection Rules ---

    // Public APK releases (no login required to read/list published versions)
    match /apk_releases/{releaseId} {
      allow get: if isValidId(releaseId) && (existing().isPublished == true || isOwner());
      allow list: if existing().isPublished == true || isOwner();

      allow create: if isOwner()
        && isValidId(releaseId)
        && isValidApkRelease(incoming())
        && incoming().id == releaseId
        && incoming().uploaderUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/apk_files/$(releaseId));

      allow update: if isOwner()
        && isValidId(releaseId)
        && isValidApkRelease(incoming())
        && incoming().id == existing().id
        && incoming().uploaderUid == existing().uploaderUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'appName', 'packageName', 'versionName', 'versionCode', 'description',
          'fileName', 'mimeType', 'byteSize', 'fileSizeLabel', 'chunkCount',
          'sha256Checksum', 'iconBase64', 'isMain', 'isPublished', 'updatedAt'
        ]);

      allow delete: if isOwner() && isValidId(releaseId);
    }

    // Encrypted APK payloads & chunked segments (public get when published; owner-only mutations)
    match /apk_files/{releaseId} {
      allow get: if isValidId(releaseId) && (existing().isPublished == true || isOwner());
      allow list: if isOwner();

      allow create: if isOwner()
        && isValidId(releaseId)
        && isValidApkFilePayload(incoming())
        && incoming().releaseId == releaseId
        && incoming().uploaderUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isOwner()
        && isValidId(releaseId)
        && isValidApkFilePayload(incoming())
        && incoming().releaseId == existing().releaseId
        && incoming().uploaderUid == existing().uploaderUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'fileName', 'mimeType', 'byteSize', 'chunkCount', 'ciphertextBase64',
          'ivBase64', 'sha256Checksum', 'isPublished', 'updatedAt'
        ]);

      allow delete: if isOwner() && isValidId(releaseId);

      match /chunks/{chunkId} {
        allow get: if isValidId(releaseId)
          && isValidId(chunkId)
          && (isOwner() || get(/databases/$(database)/documents/apk_files/$(releaseId)).data.isPublished == true);

        allow list: if isValidId(releaseId) && isOwner();

        allow create: if isOwner()
          && isValidId(releaseId)
          && isValidId(chunkId)
          && isValidApkFileChunk(incoming())
          && incoming().releaseId == releaseId
          && incoming().uploaderUid == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/apk_files/$(releaseId));

        allow update: if isOwner()
          && isValidId(releaseId)
          && isValidId(chunkId)
          && isValidApkFileChunk(incoming())
          && incoming().releaseId == existing().releaseId
          && incoming().uploaderUid == existing().uploaderUid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'chunkIndex', 'byteSize', 'ciphertextBase64', 'ivBase64', 'updatedAt'
          ]);

        allow delete: if isOwner() && isValidId(releaseId) && isValidId(chunkId);
      }
    }
  }
}
